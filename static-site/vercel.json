{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/public-api/:path*", "destination": "https://portofolio-git-codex-static-preview-rrapskuys-projects.vercel.app/public-api/:path*" },
    { "source": "/api/v1/:path*", "destination": "https://portofolio-git-codex-static-preview-rrapskuys-projects.vercel.app/api/v1/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg|png|jpg|jpeg|webp|woff2|pdf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
